{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "spotless",
  "bundle": {
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libmpv2",
          "libc6 (>= 2.39)",
          "libegl1",
          "curl"
        ],
        "recommends": [
          "desktop-file-utils"
        ]
      },
      "rpm": {
        "depends": [
          "libappindicator-gtk3",
          "mpv-libs",
          "libEGL.so.1()(64bit)",
          "curl"
        ],
        "recommends": [
          "desktop-file-utils"
        ]
      }
    }
  }
}
